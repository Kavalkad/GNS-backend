{
  "ConnectionStrings": {
    "AppDbContext": "Data Source=app.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "JwtOptions": {
    "ValidateIssuer": false,
    "ValidateAudience": false,
